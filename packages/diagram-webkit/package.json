{
  "name": "diagram-webkit",
  "version": "0.1.2",
  "description": "Interactive draw.io SVG diagrams",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diagram-webkit/diagram-webkit.git",
    "directory": "packages/diagram-webkit"
  },
  "homepage": "https://diagram-webkit.github.io",
  "bugs": "https://github.com/diagram-webkit/diagram-webkit/issues",
  "keywords": [
    "drawio",
    "draw.io",
    "diagram",
    "svg",
    "interactive",
    "reveal.js"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/types/core/index.d.ts",
      "default": "./dist/core.js"
    },
    "./reveal": {
      "types": "./dist/types/reveal/index.d.ts",
      "default": "./dist/reveal.js"
    },
    "./tools": "./src/tools/index.js",
    "./tools/vite": "./src/tools/vite-plugin.js",
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "bin": {
    "diagram-webkit": "src/tools/cli.js"
  },
  "files": [
    "dist",
    "src/tools"
  ],
  "scripts": {
    "prepack": "cp ../../README.md ../../LICENSE .",
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.core.json --noEmit && tsc -p tsconfig.js.json --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.1",
    "happy-dom": "^20.14.5",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
