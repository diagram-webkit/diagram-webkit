{
  "name": "diagram-webkit",
  "version": "0.1.0",
  "description": "Interactive draw.io SVG diagrams",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/types/core/index.d.ts",
      "default": "./dist/core.js"
    },
    "./reveal": {
      "types": "./dist/types/reveal/index.d.ts",
      "default": "./dist/reveal.js"
    },
    "./tools": "./src/tools/index.js",
    "./tools/vite": "./src/tools/vite-plugin.js",
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "bin": {
    "diagram-webkit": "./src/tools/cli.js"
  },
  "files": [
    "dist",
    "src/tools"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.core.json --noEmit && tsc -p tsconfig.js.json --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.1",
    "happy-dom": "^20.14.5",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
